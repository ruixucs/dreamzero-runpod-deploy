# ── Project-specific (RunPod deploy) ────────────────────────────────────────
# Local environment & caches
.venv/
.cache/

# Logs (we ship a single trimmed sample under runs/server.log.tail)
logs/
!runs/server.log.tail

# Model checkpoints (61 GB; downloaded by setup script)
checkpoints/
*.safetensors
*.pth
*.pt

# Generated MP4 outputs from inference runs (we explicitly include 1-2
# representative samples under runs/sample_outputs/, see whitelist below)
real_world_eval_gen_*/

# upstream listed runs/ globally; we want most of it ignored EXCEPT the
# committed evidence under runs/sample_outputs/ and runs/server.log.tail
runs/
!runs/
!runs/sample_outputs/
!runs/sample_outputs/**
!runs/server.log.tail
!runs/README.md
